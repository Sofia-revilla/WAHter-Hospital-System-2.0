{
  "name": "@wahter/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Code every WAHter service shares: event bus, database access, auth guard, and MEWS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
