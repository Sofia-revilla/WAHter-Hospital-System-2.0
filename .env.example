# Local development only. Copy to .env before `docker compose up`:
#   cp .env.example .env
# These values only work inside your own Docker network. Pick new ones for
# any shared or deployed environment, and never commit the real .env.

POSTGRES_PASSWORD=local-dev-postgres
RABBITMQ_PASSWORD=local-dev-rabbitmq
# signs staff tokens; letters, digits, and dashes only (see infra/kong/start.sh)
JWT_SECRET=local-dev-jwt-secret-change-me-for-anything-shared

# one database login per service
IDENTITY_DB_PASSWORD=local-dev-identity
CLINICAL_RECORDS_DB_PASSWORD=local-dev-clinical-records
SCHEDULING_DB_PASSWORD=local-dev-scheduling
ORDERS_DIAGNOSTICS_DB_PASSWORD=local-dev-orders-diagnostics
BILLING_DB_PASSWORD=local-dev-billing
INTEROPERABILITY_DB_PASSWORD=local-dev-interoperability
NOTIFICATIONS_DB_PASSWORD=local-dev-notifications
AUDIT_LOG_DB_PASSWORD=local-dev-audit-log

# Optional: keep the services' data on Supabase instead of the local container.
# Paste the Session pooler URI (Supabase → Connect → Session pooler) with your
# database password filled in, then run `npm run supabase:setup`. The setup
# script adds SUPABASE_PROJECT_REF, SUPABASE_POOLER_HOST, and one password per
# service below this line.
SUPABASE_DB_URL=

# Optional: where cloudflared.exe is, if it isn't on your PATH (npm run tunnel)
CLOUDFLARED_PATH=
