{
  "name": "wahter",
  "version": "0.1.0",
  "private": true,
  "description": "WAHter (WAH2.0) — inpatient hospital information system for Philippine Level 2–3 LGU hospitals. UNICA-HIJA.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*/backend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "build:shared": "npm run build --workspace @wahter/shared",
    "up": "docker compose up --build",
    "lint:frontends": "eslint -c apps/web/eslint.config.mjs \"services/*/frontend/**/*.{ts,tsx}\"",
    "tunnel": "node scripts/demo-tunnel.mjs",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "up:supabase": "docker compose -f docker-compose.yml -f docker-compose.supabase.yml up -d --build"
  }
}
